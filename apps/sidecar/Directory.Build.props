<Project>
  <!-- Lock NuGet versions, transitive ones included (packages.lock.json per project). On CI (GitHub sets CI=true)
       restore fails if the lock file is missing or out of date, so a PR build and the release build use the same
       packages. Locally, a changed PackageReference updates the lock file on the next restore: commit it. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
  <!-- The build is warning-free: keep it that way (#198). NuGet audit warnings stay warnings, because CI's audit step
       decides which advisories block, and a new advisory must not stop every local build. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>