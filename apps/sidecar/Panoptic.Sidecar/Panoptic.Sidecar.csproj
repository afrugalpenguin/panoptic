<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows only (DPAPI store, WAM sign-in; Windows until v1), which also tells CA1416 so. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>panoptic-sidecar</AssemblyName>
    <RootNamespace>Panoptic.Sidecar</RootNamespace>
    <Version>0.2.0</Version>
    <!-- Set by scripts/build-sidecar.ps1: jit, r2r, aot or fdd. Reported by ping. -->
    <PanopticMode Condition="'$(PanopticMode)' == ''">dev</PanopticMode>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="PublishMode" Value="$(PanopticMode)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Identity.Broker" Version="1.7.0" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.63.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <!-- Not used directly: pins the transitive dependency of Microsoft.Data.SqlClient 7.1.1, which asks
         for 9.0.18 (GHSA-846f-f764-76mx high, GHSA-2fmv-rv2c-59x7 moderate). Remove once SqlClient
         depends on a patched version itself: tracked in issue #41. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
