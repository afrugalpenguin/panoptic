<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>panoptic-sidecar</AssemblyName>
    <RootNamespace>Panoptic.Sidecar</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Set by scripts/build-sidecar.ps1: aot, r2r or fdd. Reported by ping. -->
    <PanopticMode Condition="'$(PanopticMode)' == ''">dev</PanopticMode>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="PublishMode" Value="$(PanopticMode)" />
  </ItemGroup>

</Project>
