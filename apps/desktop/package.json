{
  "name": "@panoptic/desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build-sidecar.ps1 -Mode jit",
    "changelog": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& ../../scripts/changelog.ps1 -Head $env:npm_package_version -Out src-tauri/CHANGELOG.md\"",
    "sidecar:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build-sidecar.ps1 -Mode fdd",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~7.0.2",
    "vite": "^8.0.16",
    "vitest": "^5"
  }
}
