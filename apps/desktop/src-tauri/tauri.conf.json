{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panoptic",
  "version": "../package.json",
  "identifier": "dev.panoptic.app",
  "build": {
    "beforeDevCommand": "pnpm sidecar:dev && pnpm changelog && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm sidecar && pnpm changelog && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Panoptic",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/panoptic-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "afrugalpenguin",
    "homepage": "https://github.com/afrugalpenguin/panoptic",
    "shortDescription": "Native multi-environment object explorer for SQL Server and Cosmos DB",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": [
      "CHANGELOG.md"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCNjQ1RTMwRjExODg1MTAKUldRUWhSanhNRjVrQytOdFpUUllDRHpaRnpWdkdvMUlCb0lIdjNWSm5HM2hBeUlNNUxCTWQwZFgK",
      "endpoints": [
        "https://github.com/afrugalpenguin/panoptic/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
