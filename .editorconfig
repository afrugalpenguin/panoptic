# Editor defaults matching the code as it is (#198). Line endings follow .gitattributes. Whitespace only:
# no analyzer severities here, since the sidecar builds with warnings as errors (apps/sidecar/Directory.Build.props).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,rs,ps1,sql}]
indent_size = 4

[*.{ps1,slnx}]
end_of_line = crlf

# Two trailing spaces are a Markdown line break.
[*.md]
trim_trailing_whitespace = false
